# Copy this file to .env.local (on your computer) or add these in
# Vercel → Project → Settings → Environment Variables (for the live site).
# See "Pitches: Supabase and email" in the README.

# The site's real address, for share previews and the sitemap (no slash at the end)
NEXT_PUBLIC_SITE_URL=https://sciencesphere.example

# Supabase → Project Settings → API (or "Data API" / "API Keys")
SUPABASE_URL=https://your-project.supabase.co
# the SECRET service role key, never the public anon key; keep it out of git
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys
RESEND_API_KEY=
# who the pitch emails come from; must be on a domain verified in Resend → Domains
PITCH_FROM_EMAIL=Science Sphere <pitches@sciencesphere.example>
